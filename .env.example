# Copy to .env (git-ignored). The rlr CLI loads it at startup; variables
# already set in your shell take precedence. Never commit a real key.

# Live machine translation through Gloo AI Studio: set RLR_MT=gloo here,
# or pass --live to `rlr serve` (./run demo --live).
# RLR_MT=gloo

# Gloo AI Studio API key (preferred).
GLOO_API_KEY=

# Or, as in Relay: OAuth2 client credentials (deprecated by Gloo, sunset
# December 2026), or GLOO_CLIENT_ID=apikey with the API key in
# GLOO_CLIENT_SECRET.
# GLOO_CLIENT_ID=
# GLOO_CLIENT_SECRET=

# Router model (optional).
# GLOO_MODEL=gloo-anthropic-claude-sonnet-4.6
